# Copy this file to .env. Never commit .env or secrets/.
# Docker Compose v2.24+ is required for optional env_file support.
# Default is real source ingestion. Demo mode is an explicit separate choice.
APP_MODE=live
PORT=3000
BIND_ADDRESS=127.0.0.1

# Set both POSTGRES_PASSWORD and DATABASE_URL consistently when changing these.
# URL-encode special characters in the password inside DATABASE_URL.
POSTGRES_USER=trends
POSTGRES_PASSWORD=trends_local
POSTGRES_DB=trends
DATABASE_URL=postgresql+psycopg://trends:trends_local@db:5432/trends

# Stack Exchange application key (optional for limited unauthenticated access).
# Recommended for a useful backfill quota. Values never reach the browser.
STACKEXCHANGE_API_KEY=
STACKEXCHANGE_ACCESS_TOKEN=
STACKEXCHANGE_SITE=stackoverflow

# Worker controls. Source backoff can override polling frequency.
POLL_INTERVAL_SECONDS=600
BACKFILL_DAYS=90
QUOTA_RESERVE=200
RECONCILE_INTERVAL_SECONDS=3600
ANSWER_ENRICHMENT_BATCH=3
RETENTION_DAYS=395
MAX_SNAPSHOT_QUESTIONS=100000
LOG_LEVEL=INFO

# Optional semantic model: use compose.model.yaml and a mounted local model.
# TOPIC_MODEL=/models/topic-encoder
